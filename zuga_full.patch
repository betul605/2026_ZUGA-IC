+{
+  "//": "ZUGA-IC OpenLane (klasik) config -- tam GDSII akisi (sentez->P&R->CTS->DRC/LVS->GDS)",
+  "//_kullanim": "OpenLane repo altinda: ./flow.tcl -design <bu klasor>  (veya OpenLane2: openlane config_openlane.json)",
+  "//_blok_degistir": "Baska blok icin DESIGN_NAME ve VERILOG_FILES'i degistirin (gpio_axi/timer_axi/uart_axi/yz_csr...).",
+
+  "DESIGN_NAME": "i2c_master_axi",
+  "VERILOG_FILES": "dir::../rtl/i2c_master_axi.sv",
+
+  "CLOCK_PORT": "clk_i",
+  "CLOCK_PERIOD": 20.0,
+
+  "PDK": "sky130A",
+  "STD_CELL_LIBRARY": "sky130_fd_sc_hd",
+
+  "FP_SIZING": "relative",
+  "FP_CORE_UTIL": 40,
+  "PL_TARGET_DENSITY": 0.45,
+
+  "RUN_LINTER": true,
+  "SYNTH_STRATEGY": "AREA 0",
+
+  "//_yz_top_notu": "yz_top/yz_accel sentezi icin SYNTH_DEFINES=SYNTHESIS ekleyin ve tam Tiny Conv bellekleri icin OpenRAM/sky130 SRAM makrolari EXTRA_LEFS/EXTRA_LIBS ile eklenmelidir (kucuk konfig std-hucre olarak cikar).",
+  "SYNTH_DEFINES": ["SYNTHESIS"],
+
+  "//_signoff": "Magic DRC + netgen LVS OpenLane icinde otomatik kosar; sonuclar runs/<tag>/reports/ altinda.",
+  "MAGIC_DRC_USE_GDS": true,
+  "RUN_MAGIC_DRC": true,
+  "RUN_LVS": true
+}
